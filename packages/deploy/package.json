{
  "name": "@workspace/deploy",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt --write \"**/*.{ts,tsx}\" package.json",
    "format:check": "vp fmt --check \"**/*.{ts,tsx}\" package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/target.ts",
    "./stack": "./src/stack.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "^22",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/infisical": "catalog:",
    "@effect/platform-bun": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  }
}
