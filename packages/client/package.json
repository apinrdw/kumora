{
  "name": "@workspace/client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write \"**/*.{ts,tsx}\" package.json",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\" package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./base-path": "./src/base-path.ts",
    "./testing": "./src/testing.ts"
  },
  "dependencies": {
    "@workspace/relay": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
