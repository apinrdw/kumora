      "css": ".ds-btn-primary{font-family:'Manrope Variable',Arial,sans-serif;display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:6px;font-size:13px;line-height:18px;font-weight:500;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:var(--accent-primary,#55d9c7);color:var(--accent-on-primary,#09242a);border:1px solid transparent;}.ds-btn-primary:hover{background:var(--accent-hover,#7be6d8);}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px;}"
