      "css": ".ds-btn-ghost{font-family:'Manrope Variable',Arial,sans-serif;display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border-radius:6px;font-size:13px;line-height:18px;font-weight:500;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:transparent;color:var(--text-secondary,#b0c2d2);border:1px solid transparent;}.ds-btn-ghost:hover{background:var(--bg-elevated,#1b2c40);color:var(--text-primary,#edf4fb);}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px;}"
