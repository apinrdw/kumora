{
  "name": "dashboard",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun alchemy dev",
    "generate-routes": "tsr generate",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run --passWithNoTests && node scripts/auth-migrations.ts --check",
    "auth:migrations": "node scripts/auth-migrations.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@better-auth/kysely-adapter": "1.7.18",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@workspace/client": "workspace:*",
    "@workspace/deploy": "workspace:*",
    "@workspace/relay": "workspace:*",
    "@workspace/server": "workspace:*",
    "@workspace/ui": "workspace:*",
    "alchemy": "catalog:",
    "better-auth": "1.7.18",
    "effect": "catalog:",
    "kysely": "0.29.8",
    "lightweight-charts": "5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@effect/vitest": "catalog:",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.41",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2",
    "vite": "^8"
  }
}
