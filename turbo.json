{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [
    ".oxlintrc.json",
    ".oxfmtrc.json"
  ],
  "tasks": {
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEPLOY_PROBE_SECRET",
        // Read by apps/dashboard/alchemy.run.ts; apps/e2e/playwright.config.ts
        // sets it for the Test stage.
        "ADMIN_EMAILS",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#format:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#format:check:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "tsconfig.json"
      ]
    },
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "turbo.json",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml"
      ]
    }
  }
}
