{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    // Only apps/extension builds; the apps deploy through Alchemy instead.
    // Decision: CI's package tasks hash no Markdown, so GLOSSARY edits replay cache
    // (docs/adr/0017-ci-package-tasks-hash-no-markdown.md)
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEPLOY_PROBE_SECRET",
        // Read by apps/dashboard/alchemy.run.ts; apps/e2e/playwright.config.ts
        // sets it for the Test stage.
        "ADMIN_EMAILS",
        // Read by apps/dashboard/alchemy.run.ts on the Test stage, like
        // ADMIN_EMAILS; apps/e2e/playwright.config.ts sets it.
        "INGEST_TOKEN",
        // Read by apps/dashboard/alchemy.run.ts on the Test stage only;
        // apps/e2e/playwright.config.ts sets it (apps/e2e/support/clock.ts).
        "MARKET_LIVE_CLOCK_OFFSET",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE",
        // packages/deploy/src/target.ts devPort; apps/e2e/support/ports.ts
        // sets them.
        "KUMORA_WEB_PORT",
        "KUMORA_DASHBOARD_PORT"
      ]
    },
    // vitest.timeout.mts reads CI to give tests CI's timeout there.
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": ["CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.timeout.mts",
        "!**/*.md"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    // A root task's default inputs are every file in the repo, Markdown
    // included, which `vp check` formats; vite.config.ts is among them.
    // Decision: tsrs checks types through vp check, with type-aware lint on
    // (docs/adr/0023-types-are-checked-by-tsrs-through-vp-check-with-type-aware-lint-on.md)
    "//#vp-check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    // Decision: the root tests split by what they read, checked by a repo test
    // (docs/adr/0018-root-tests-split-by-what-they-read.md)
    "//#test:root": {
      "inputs": ["scripts/**", "vitest.config.*", "vite.config.ts"]
    },
    // All of scripts/**, not only what these tests import: root-test-inputs
    // reads every test's source and ci-checks lists scripts/check-*.mts.
    "//#test:repo": {
      "inputs": [
        "scripts/**",
        "vitest.config.*",
        "turbo.json",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        ".github/workflows/**",
        ".claude/hooks/fallow-gate.sh",
        ".claude/hooks/merge-gate.sh"
      ]
    }
  }
}
