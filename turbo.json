{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": [
    ".oxlintrc.json",
    "scripts/oxlint-plugin.mts",
    ".oxfmtrc.json"
  ],
  "tasks": {
    // Decision: the package tasks CI runs (typecheck, build, lint,
    // format:check, test) and test's transit hash no Markdown, so a
    // GLOSSARY-only edit replays them from cache. No package's code or tests
    // read a .md file; one that starts to must drop the "!**/*.md" from the
    // tasks that read it.
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    // Only apps/extension builds; the apps deploy through Alchemy instead.
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEPLOY_PROBE_SECRET",
        // Read by apps/dashboard/alchemy.run.ts; apps/e2e/playwright.config.ts
        // sets it for the Test stage.
        "ADMIN_EMAILS",
        // Read by apps/dashboard/alchemy.run.ts on the Test stage, like
        // ADMIN_EMAILS; apps/e2e/playwright.config.ts sets it.
        "INGEST_TOKEN",
        // Read by apps/dashboard/alchemy.run.ts on the Test stage only;
        // apps/e2e/playwright.config.ts sets it (apps/e2e/support/clock.ts).
        "MARKET_LIVE_CLOCK_OFFSET",
        "ALCHEMY_STAGE",
        "ALCHEMY_PROFILE"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#format:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#format:check:root": {
      "inputs": [
        "scripts/**"
      ]
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "tsconfig.json"
      ]
    },
    // Decision: the root tests split by what they read, so a workflow or
    // lockfile edit reruns only the *.repo.test.mts files that read live repo
    // config (#170). scripts/root-test-inputs.repo.test.mts checks each task's
    // inputs cover the files its tests read.
    "//#test:root": {
      "inputs": [
        "scripts/**",
        "vitest.config.*",
        ".oxlintrc.json"
      ]
    },
    // All of scripts/**, not only what these tests import: root-test-inputs
    // reads every test's source and ci-checks lists scripts/check-*.mts.
    "//#test:repo": {
      "inputs": [
        "scripts/**",
        "vitest.config.*",
        "turbo.json",
        "package.json",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml",
        ".github/workflows/**",
        ".claude/hooks/fallow-gate.sh"
      ]
    }
  }
}
