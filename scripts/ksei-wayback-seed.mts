// The Deep backfill's seed: every KSEI report filename the Wayback Machine
// captured under KSEI's old download paths. `pnpm ksei:wayback-seed`
// (write-ksei-wayback-seed.mts) runs it once and commits its output,
// apps/dashboard/src/server/ksei/wayback-seed.ts, which the dashboard Worker
// imports: the Worker never calls archive.org. Spec apinrdw/kumora#327,
// "Deep backfill".
import { Effect, Schedule, Schema } from "effect"
import { HttpClient } from "effect/http"

// KSEI's old download paths; `ksei.co.id/storage/Download/` has no captures.
export const CDX_URLS = [
  "ksei.co.id/Download/",
  "web.ksei.co.id/Download/",
].map(
  (prefix) =>
    `https://web.archive.org/cdx/search/cdx?url=${prefix}&matchType=prefix&output=json&fl=original,timestamp,statuscode`
)

export const SEED_PATH = "apps/dashboard/src/server/ksei/wayback-seed.ts"

// The KSEI report filenames: KSEI_FILENAME in
// apps/dashboard/src/server/ksei/listing.ts, which a Node script can't import.
// A change to one belongs in the other; the dashboard's seed test parses every
// seeded name with that one.
const KSEI_FILENAME =
  /^(?:StatisEfek\d{8}\.txt\.zip|BalanceposEfek\d{8}(?:\.txt)?\.zip)$/

// A CDX answer with `output=json`: a header row, then one row per capture.
const CdxRows = Schema.Array(Schema.Array(Schema.String))

// Decision: a revisit (statuscode `-`) counts as a capture: Wayback records
// one when the bytes matched an earlier capture, so the file was there. Of
// 2026-11-14's 140 report rows, the 23 revisits name no file a 200 doesn't,
// so this decides nothing today. A 3xx or 4xx capture saw no file and is
// left out. See apinrdw/kumora#330.
const CAPTURED = new Set(["200", "-"])

// The distinct report filenames the captures name, sorted.
export const seedFilenames = Effect.fnUntraced(function* (
  answers: ReadonlyArray<ReadonlyArray<ReadonlyArray<string>>>
) {
  const names = answers.flatMap((rows) =>
    rows.slice(1).flatMap(([original = "", , status = ""]) => {
      const filename = URL.parse(original)?.pathname.split("/").at(-1) ?? ""
      return CAPTURED.has(status) && KSEI_FILENAME.test(filename)
        ? [filename]
        : []
    })
  )
  return [...new Set(names)].sort()
})

export const seedModule = Effect.fnUntraced(function* (
  names: ReadonlyArray<string>
) {
  return [
    "// Generated by `pnpm ksei:wayback-seed` (scripts/ksei-wayback-seed.mts)",
    "// from the Wayback Machine's CDX index. Do not edit by hand.",
    "",
    "// Every KSEI report filename Wayback captured under KSEI's old download",
    "// paths. A Deep backfill fetches those from the archive's first month on",
    "// (FIRST_MONTH, coverage.ts) before it probes.",
    "export const WAYBACK_SEED: ReadonlyArray<string> = [",
    ...names.map((name) => `  ${JSON.stringify(name)},`),
    "]",
    "",
  ].join("\n")
})

// The CDX API answers 503 under load: retried, a few seconds apart.
export const fetchCdx = Effect.fn("fetchCdx")(function* (url: string) {
  const client = HttpClient.filterStatusOk(yield* HttpClient.HttpClient)
  const response = yield* client
    .get(url)
    .pipe(
      Effect.retry({ schedule: Schedule.exponential("2 seconds"), times: 5 })
    )
  return yield* Schema.decodeUnknownEffect(CdxRows)(yield* response.json)
})
