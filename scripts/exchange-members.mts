// IDX's exchange-member list, the table the dashboard looks custodians' broker
// codes up in (spec apinrdw/kumora#673, "Broker codes"). `pnpm
// idx:exchange-members` (write-exchange-members.mts) fetches it once and
// commits its output, apps/dashboard/src/lib/exchange-members.ts: the
// dashboard never calls IDX for it.
import { Effect, Schema } from "effect"
import { HttpClient, HttpClientRequest } from "effect/http"

// From www.idx.id, which answers without the Cloudflare challenge
// www.idx.co.id gives a script. `length` because it defaults to a page.
const MEMBERS_URL =
  "https://www.idx.id/primary/ExchangeMember/GetBrokerSearch?option=0&license=&start=0&length=9999"

export const MEMBERS_PATH = "apps/dashboard/src/lib/exchange-members.ts"

const MembersResponse = Schema.Struct({
  recordsTotal: Schema.Number,
  data: Schema.Array(
    Schema.Struct({
      Code: Schema.String.check(Schema.isPattern(/^[A-Z]{2}$/)),
      Name: Schema.String,
    })
  ),
})
type MembersResponse = typeof MembersResponse.Type

class MembersIncomplete extends Schema.TaggedError<MembersIncomplete>()(
  "MembersIncomplete",
  { listed: Schema.Number, sent: Schema.Number }
) {
  override get message() {
    return `IDX lists ${this.listed} members but sent ${this.sent}; raise the URL's length`
  }
}

export const fetchMembers = Effect.fn("fetchMembers")(function* () {
  const client = HttpClient.filterStatusOk(yield* HttpClient.HttpClient)
  const response = yield* client.execute(
    HttpClientRequest.get(MEMBERS_URL).pipe(
      HttpClientRequest.setHeader("user-agent", "Mozilla/5.0 (compatible)")
    )
  )
  return yield* Schema.decodeUnknownEffect(MembersResponse)(
    yield* response.json
  )
})

export const membersModule = Effect.fnUntraced(function* ({
  recordsTotal,
  data,
}: MembersResponse) {
  if (data.length !== recordsTotal)
    return yield* new MembersIncomplete({
      listed: recordsTotal,
      sent: data.length,
    })
  const members = [...data].sort((a, b) => a.Code.localeCompare(b.Code))
  return [
    "// Generated by `pnpm idx:exchange-members` (scripts/exchange-members.mts)",
    "// from IDX's exchange-member list. Do not edit by hand.",
    "",
    'import { BrokerCode } from "@workspace/relay"',
    'import { Schema } from "effect"',
    "",
    "// Every member firm IDX lists: its broker code and name, as IDX writes them.",
    "export const EXCHANGE_MEMBERS = Schema.decodeUnknownSync(",
    "  Schema.Array(Schema.Tuple([BrokerCode, Schema.String]))",
    ")([",
    ...members.map(
      ({ Code, Name }) =>
        `  [${JSON.stringify(Code)}, ${JSON.stringify(Name.trim())}],`
    ),
    "])",
    "",
  ].join("\n")
})
