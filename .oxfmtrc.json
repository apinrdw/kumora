{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/worker-configuration.d.ts",
    "dist/",
    ".turbo/",
    ".output/",
    ".nitro/",
    ".tanstack/",
    "coverage/"
  ]
}
