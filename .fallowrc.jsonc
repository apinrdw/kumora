{
  // A throwaway prototype folder on a `prototype/*` branch (the prototype
  // skill's static pages) holds pages and helper scripts that nothing imports.
  "ignorePatterns": ["repos/**", "apps/*/prototype-*/**"],
  // Workers Builds runs deploy.ts by path (docs/runbooks/deploy.md, step 4),
  // so no module imports it. The row budgets bundle
  // apps/dashboard/billing/worker.ts by path
  // (apps/dashboard/tests/server/market-live/workerd.ts). Chrome loads the extension's entries from its
  // manifest (apps/extension/manifest.ts). .github/workflows/release.yml runs
  // judge-release-tag.mts by path.
  "entry": [
    "packages/deploy/src/deploy.ts",
    "scripts/judge-release-tag.mts",
    "apps/dashboard/billing/worker.ts",
    "apps/extension/src/worker/service-worker.ts",
    "apps/extension/src/content/broker.ts",
    "apps/extension/src/content/page.ts",
    "apps/extension/src/options/main.tsx"
  ],
  // The Workers runtime calls a Durable Object's handlers; no module does
  // (apps/dashboard/src/server/market-live/trading-day-object.ts).
  "usedClassMembers": [
    "fetch",
    "webSocketMessage",
    "webSocketClose",
    "webSocketError",
    "alarm",
    // Lightweight Charts calls a series primitive's hooks; no module does
    // (apps/dashboard/src/components/market-live/cursor-line.ts,
    // sweep-bubbles.ts).
    "attached",
    "detached",
    "paneViews",
    "hitTest"
  ],
  // Decision: the root declares the optional peers alchemy loads at runtime
  // (docs/adr/0002-the-root-declares-alchemy-s-optional-runtime-peers.md)
  "ignoreDependencies": [
    "@alchemy.run/frontend-frameworks",
    "@alchemy.run/infisical",
    "@effect/platform-bun",
    "@effect/platform-node"
  ]
}
