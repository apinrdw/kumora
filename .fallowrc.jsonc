{
  "ignorePatterns": ["repos/**"],
  // Workers Builds runs deploy.ts by path (docs/runbooks/deploy.md, step 4),
  // so no module imports it. Chrome loads the extension's entries from its
  // manifest (apps/extension/manifest.ts).
  "entry": [
    "packages/deploy/src/deploy.ts",
    "apps/extension/src/worker/service-worker.ts",
    "apps/extension/src/content/broker.ts",
    "apps/extension/src/content/page.ts",
    "apps/extension/src/options/main.tsx"
  ],
  // The Workers runtime calls a Durable Object's handlers; no module does
  // (apps/dashboard/src/server/market-live/trading-day-object.ts).
  "usedClassMembers": [
    "fetch",
    "webSocketMessage",
    "webSocketClose",
    "webSocketError",
    "alarm"
  ],
  // Decision: alchemy and @alchemy.run/cloudflare load these optional peers at
  // runtime; without them `alchemy dev` fails with "could not load the required
  // peer dependency @effect/platform-bun". pnpm never auto-installs optional
  // peers, so the root declares them and every workspace resolves them from
  // there. @alchemy.run/infisical is here for the CLI: `alchemy profile` finds
  // auth providers in the manifests above the app folder, and only
  // packages/deploy imports it. They take their versions from the effect and
  // alchemy entries of the pnpm-workspace.yaml catalog. alchemy's ws peer
  // resolves to the copy @effect/platform-node-shared brings (apinrdw/kumora#122).
  // See apinrdw/kumora#16.
  "ignoreDependencies": [
    "@alchemy.run/frontend-frameworks",
    "@alchemy.run/infisical",
    "@effect/platform-bun",
    "@effect/platform-node"
  ]
}
