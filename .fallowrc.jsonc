{
  // Decision: throwaway prototype folders (this branch only) hold standalone helper scripts nothing imports.
  "ignorePatterns": ["repos/**", "apps/dashboard/prototype-*/**"],
  // Workers Builds runs deploy.ts by path (docs/runbooks/deploy.md, step 4),
  // so no module imports it. Chrome loads the extension's entries from its
  // manifest (apps/extension/manifest.ts).
  "entry": [
    "packages/deploy/src/deploy.ts",
    "apps/extension/src/worker/service-worker.ts",
    "apps/extension/src/content/broker.ts",
    "apps/extension/src/content/page.ts",
    "apps/extension/src/options/main.tsx"
  ],
  // The Workers runtime calls a Durable Object's handlers; no module does
  // (apps/dashboard/src/server/market-live/trading-day-object.ts).
  "usedClassMembers": [
    "fetch",
    "webSocketMessage",
    "webSocketClose",
    "webSocketError",
    "alarm"
  ],
  // Decision: the root declares the optional peers alchemy and
  // @alchemy.run/cloudflare load at runtime (`alchemy dev` fails without
  // @effect/platform-bun), since pnpm never auto-installs optional peers.
  // @alchemy.run/infisical is for `alchemy profile`, which reads the manifests
  // above the app folder. See apinrdw/kumora#16 and #122.
  "ignoreDependencies": [
    "@alchemy.run/frontend-frameworks",
    "@alchemy.run/infisical",
    "@effect/platform-bun",
    "@effect/platform-node"
  ]
}
