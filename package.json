{
  "name": "kumora",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check": "pnpm check:static && pnpm check:test",
    "check:static": "turbo run typecheck typecheck:root build lint lint:root format:check format:check:root test:root test:repo && node scripts/check-skill-links.mts && node scripts/check-decision-docs.mts && node scripts/check-no-gitlinks.mts && node scripts/check-package-scripts.mts && node scripts/check-oxlint-overrides.mts && node scripts/check-extension-version.mts && node scripts/check-applied-migrations.mts",
    "check:test": "turbo run test",
    "dev": "turbo dev",
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "oxlint scripts",
    "format": "turbo run format format:root",
    "format:root": "oxfmt --write \"scripts/**/*.mts\"",
    "format:check": "turbo run format:check format:check:root",
    "format:check:root": "oxfmt --check \"scripts/**/*.mts\"",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "test": "turbo run test test:root test:repo",
    "test:e2e": "pnpm --filter e2e e2e",
    "ci-timings": "node scripts/report-ci-timings.mts",
    "e2e:evidence": "node scripts/e2e-evidence.mts",
    "ksei:wayback-seed": "node scripts/write-ksei-wayback-seed.mts",
    "prepare": "git config core.hooksPath .githooks",
    "test:root": "vitest run --dir scripts --exclude \"**/*.repo.test.mts\"",
    "test:repo": "vitest run --dir scripts .repo.test.mts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@alchemy.run/infisical": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "^22",
    "fallow": "3.39.0",
    "oxc-parser": "0.120.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "^2.11.7",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
