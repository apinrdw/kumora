{
  // Decision: Oxlint and Oxfmt replace ESLint and Prettier: the same rule set
  // lints the whole repo in 1.4 s against about 4 s per workspace. Vite Plus was
  // deferred because it re-aliases `vite` and adds a second task runner.
  // Type-aware rules (tsgolint) are off and `tsc --noEmit` stays the type gate:
  // tsgolint's type-check mode is experimental. See apinrdw/kumora-monorepo#3.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-restricted-imports": ["error", {"paths": [{"name": "cloudflare:workers", "message": "Use the WorkerEnv service from @workspace/server; only its bridge reaches cloudflare:workers."}, {"name": "zod", "message": "Use Effect Schema (`import { Schema } from \"effect\"`); it is the only schema library."}, {"name": "@effect/schema", "message": "Effect v3 package. Use `Schema` from `effect` (v4)."}, {"name": "@effect/platform", "message": "Effect v3 package. Use the `effect/*` platform modules (v4), e.g. `effect/http/HttpClient`."}, {"name": "@effect/rpc", "message": "Effect v3 package. Use `effect/unstable/rpc` (v4)."}], "patterns": [{"group": ["**/repos/**", "repos/**"], "message": "repos/ is a read-only reference. Import the installed package instead."}, {"group": ["@effect/schema/*", "@effect/platform/*", "@effect/rpc/*"], "message": "Effect v3 package. Use the matching `effect/*` module (v4)."}]}],
    "no-case-declarations": "error",
    "no-fallthrough": "error",
    "no-regex-spaces": "error",
    "no-shadow": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "require-yield": "off",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": false, "ts-ignore": "allow-with-description" }],
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/method-signature-style": ["error", "property"],
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/no-namespace": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-for-of": "warn",
    "unicorn/prefer-node-protocol": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react/refs": "warn",
    "react/use-memo": "warn",
    "react/void-use-memo": "warn",
    "react/static-components": "warn",
    "react/globals": "warn",
    "react/error-boundaries": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/incompatible-library": "warn",
    "react/hooks": "warn",
    "react/memo-dependencies": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/capitalized-calls": "warn",
    "react/invariant": "warn",
    "react/rule-suppression": "warn",
    "react/syntax": "warn",
    "react/unsupported-syntax": "warn",
    "react/todo": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "warn",
    "vitest/no-identical-title": "error",
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["it.effect", "it.live"] }],
    "vitest/valid-expect": "error",
    "vitest/valid-title": "error"
  },
  "ignorePatterns": ["**/routeTree.gen.ts", "**/dist/**", "**/.output/**", "**/.nitro/**", "**/.tanstack/**", "**/coverage/**", "repos/**", "**/.alchemy/**"],
  "overrides": [
    {
      // The bridge is the one module that may reach cloudflare:workers.
      "files": ["packages/server/src/bridge.ts", "src/bridge.ts"],
      "rules": {
        "no-restricted-imports": ["error", {"paths": [{"name": "zod", "message": "Use Effect Schema (`import { Schema } from \"effect\"`); it is the only schema library."}, {"name": "@effect/schema", "message": "Effect v3 package. Use `Schema` from `effect` (v4)."}, {"name": "@effect/platform", "message": "Effect v3 package. Use the `effect/*` platform modules (v4), e.g. `effect/http/HttpClient`."}, {"name": "@effect/rpc", "message": "Effect v3 package. Use `effect/unstable/rpc` (v4)."}], "patterns": [{"group": ["**/repos/**", "repos/**"], "message": "repos/ is a read-only reference. Import the installed package instead."}, {"group": ["@effect/schema/*", "@effect/platform/*", "@effect/rpc/*"], "message": "Effect v3 package. Use the matching `effect/*` module (v4)."}]}]
      }
    }
  ]
}
