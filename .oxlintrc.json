{
  // Decision: Oxlint and Oxfmt replace ESLint and Prettier; tsc stays the type gate
  // (docs/adr/0011-oxlint-and-oxfmt-replace-eslint-and-prettier.md)
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": { "correctness": "error" },
  "rules": {
    "no-unused-vars": ["error", { "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }],
    "no-restricted-imports": ["error", {"paths": [{"name": "cloudflare:workers", "message": "Use the WorkerEnv service from @workspace/server; only its bridge and its Workflow runner reach cloudflare:workers."}, {"name": "zod", "message": "Use Effect Schema (`import { Schema } from \"effect\"`); it is the only schema library."}, {"name": "@effect/schema", "message": "Effect v3 package. Use `Schema` from `effect` (v4)."}, {"name": "@effect/platform", "message": "Effect v3 package. Use the `effect/*` platform modules (v4), e.g. `effect/http/HttpClient`."}, {"name": "@effect/rpc", "message": "Effect v3 package. Use `effect/unstable/rpc` (v4)."}], "patterns": [{"group": ["**/repos/**", "repos/**"], "message": "repos/ is a read-only reference. Import the installed package instead."}, {"group": ["@effect/schema/*", "@effect/platform/*", "@effect/rpc/*"], "message": "Effect v3 package. Use the matching `effect/*` module (v4)."}]}],
    "no-case-declarations": "error",
    "no-fallthrough": "error",
    "no-regex-spaces": "error",
    "no-shadow": "warn",
    "no-var": "error",
    "prefer-const": "error",
    "require-yield": "off",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": false, "ts-ignore": "allow-with-description" }],
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/method-signature-style": ["error", "property"],
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/no-namespace": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-for-of": "warn",
    "unicorn/prefer-node-protocol": "error",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react/refs": "warn",
    "react/use-memo": "warn",
    "react/void-use-memo": "warn",
    "react/static-components": "warn",
    "react/globals": "warn",
    "react/error-boundaries": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/incompatible-library": "warn",
    "react/hooks": "warn",
    "react/memo-dependencies": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/capitalized-calls": "warn",
    "react/invariant": "warn",
    "react/rule-suppression": "warn",
    "react/syntax": "warn",
    "react/unsupported-syntax": "warn",
    "react/todo": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "warn",
    "vitest/no-identical-title": "error",
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["it.effect", "it.effect.each", "it.live"] }],
    "vitest/valid-expect": "error",
    "vitest/valid-title": "error"
  },
  "ignorePatterns": ["**/routeTree.gen.ts", "**/dist/**", "**/.output/**", "**/.nitro/**", "**/.tanstack/**", "**/coverage/**", "repos/**", "**/.alchemy/**"],
  // Overrides replace a rule's root options, they don't merge, so every
  // override that sets no-restricted-imports restates the root paths and
  // patterns. scripts/check-oxlint-overrides.mts fails when one is missing.
  // Decision: packages/ui/src is in no lint override, so shadcn output lints as is
  // (docs/adr/0012-shadcn-output-in-packages-ui-lints-unedited.md)
  "overrides": [
    {
      // The full Effect ban set, tests included. A workspace that moves to
      // Effect adds its globs here; an exception is a later override.
      "files": ["scripts/**", "packages/server/src/**", "packages/server/tests/**", "packages/client/src/**", "packages/client/tests/**", "packages/deploy/src/**", "packages/deploy/tests/**", "packages/relay/src/**", "packages/relay/tests/**", "apps/extension/src/worker/**", "apps/extension/src/options/**", "apps/extension/tests/**", "apps/web/alchemy.run.ts", "apps/web/src/**", "apps/dashboard/alchemy.run.ts", "apps/dashboard/src/**", "apps/dashboard/billing/**", "apps/dashboard/tests/*.ts", "apps/dashboard/tests/lib/**", "apps/dashboard/tests/server/**", "apps/dashboard/tests/components/**/*.ts"],
      "jsPlugins": ["./scripts/oxlint-plugin.mts"],
      "rules": {
        "no-restricted-imports": ["error", {"paths": [{"name": "cloudflare:workers", "message": "Use the WorkerEnv service from @workspace/server; only its bridge and its Workflow runner reach cloudflare:workers."}, {"name": "zod", "message": "Use Effect Schema (`import { Schema } from \"effect\"`); it is the only schema library."}, {"name": "@effect/schema", "message": "Effect v3 package. Use `Schema` from `effect` (v4)."}, {"name": "@effect/platform", "message": "Effect v3 package. Use the `effect/*` platform modules (v4), e.g. `effect/http/HttpClient`."}, {"name": "@effect/rpc", "message": "Effect v3 package. Use `effect/unstable/rpc` (v4)."}], "patterns": [{"group": ["**/repos/**", "repos/**"], "message": "repos/ is a read-only reference. Import the installed package instead."}, {"group": ["@effect/schema/*", "@effect/platform/*", "@effect/rpc/*"], "message": "Effect v3 package. Use the matching `effect/*` module (v4)."}, {"regex": "^(node:)?fs(/.*)?$", "message": "Use the FileSystem and Path services from `effect` (the platform services layer provides them)."}, {"regex": "^(node:)?child_process$", "message": "Use ChildProcess from `effect/process`. spawner.lines and spawner.string ignore the exit code, so await handle.exitCode."}]}],
        "no-restricted-properties": ["error", {"object": "process", "property": "exit", "message": "Fail with a tagged error instead (return yield* new SomeError(...)); runMain exits 1 on a failure."}, {"object": "process", "property": "env", "message": "Read env through Config (Config.NonEmptyString, Config.Redacted)."}],
        "no-restricted-globals": ["error", {"name": "Promise", "message": "Wrap a Promise API with Effect.promise or Effect.tryPromise, and a callback API with Effect.callback."}],
        // Its message is fixed text; CODING_STANDARDS.md says to write Effect.gen.
        "oxc/no-async-await": "error",
        "kumora/restricted-syntax": ["error", {"selector": "ThrowStatement", "message": "Do not throw. Return yield* new SomeError(...) (a Schema.TaggedError), or Effect.fail."}, {"selector": "MemberExpression[object.name='globalThis'][property.name='process']", "message": "Reach the process through Effect: Config for env, Stdio for argv, and fail with a tagged error instead of exiting."}]
      }
    },
    {
      // The bridge, and the Workflow runner whose class must extend
      // WorkflowEntrypoint, are the only modules that may reach
      // cloudflare:workers. It must stay after the Effect override, which it
      // narrows.
      "files": ["packages/server/src/bridge.ts", "packages/server/src/workflow.ts"],
      "rules": {
        "no-restricted-imports": ["error", {"paths": [{"name": "zod", "message": "Use Effect Schema (`import { Schema } from \"effect\"`); it is the only schema library."}, {"name": "@effect/schema", "message": "Effect v3 package. Use `Schema` from `effect` (v4)."}, {"name": "@effect/platform", "message": "Effect v3 package. Use the `effect/*` platform modules (v4), e.g. `effect/http/HttpClient`."}, {"name": "@effect/rpc", "message": "Effect v3 package. Use `effect/unstable/rpc` (v4)."}], "patterns": [{"group": ["**/repos/**", "repos/**"], "message": "repos/ is a read-only reference. Import the installed package instead."}, {"group": ["@effect/schema/*", "@effect/platform/*", "@effect/rpc/*"], "message": "Effect v3 package. Use the matching `effect/*` module (v4)."}, {"regex": "^(node:)?fs(/.*)?$", "message": "Use the FileSystem and Path services from `effect` (the platform services layer provides them)."}, {"regex": "^(node:)?child_process$", "message": "Use ChildProcess from `effect/process`. spawner.lines and spawner.string ignore the exit code, so await handle.exitCode."}]}]
      }
    },
    {
      // The deploy token swap and its test are the Effect-override files that write process.env:
      // alchemy's plan and Infisical read it there, not through Config. It
      // must stay after the Effect override, which it narrows. See
      // apinrdw/kumora#107.
      "files": ["packages/deploy/src/token-swap.ts", "packages/deploy/tests/token-swap.test.ts"],
      "rules": {
        "no-restricted-properties": ["error", {"object": "process", "property": "exit", "message": "Fail with a tagged error instead (return yield* new SomeError(...)); runMain exits 1 on a failure."}]
      }
    },
    {
      // React code: routes may `throw redirect(...)` and `throw notFound()`,
      // TanStack Router's control flow. Every other ban still applies. It
      // must stay after the Effect override, which it narrows.
      "files": ["apps/web/src/routes/**", "apps/dashboard/src/routes/**"],
      "jsPlugins": ["./scripts/oxlint-plugin.mts"],
      "rules": {
        "kumora/restricted-syntax": ["error", {"selector": "MemberExpression[object.name='globalThis'][property.name='process']", "message": "Reach the process through Effect: Config for env, Stdio for argv, and fail with a tagged error instead of exiting."}]
      }
    },
    {
      // Decision: the tape is the one dashboard module that runs SQL on a trades table
      // (docs/adr/0013-the-tape-is-the-one-module-that-runs-sql-on-a-trades-table.md)
      "files": ["apps/dashboard/src/**"],
      "jsPlugins": ["./scripts/oxlint-plugin.mts"],
      "rules": {
        "kumora/tape-owns-trades": "error"
      }
    },
    {
      "files": ["apps/dashboard/src/server/market-live/tape.ts"],
      "rules": {
        "kumora/tape-owns-trades": "off"
      }
    },
    {
      // Root scripts hold none of the exceptions to CODING_STANDARDS.md's
      // "Every non-component function returns an Effect" but the ones the
      // next override names, so lint holds the rule there.
      "files": ["scripts/**"],
      "jsPlugins": ["./scripts/oxlint-plugin.mts"],
      "rules": {
        "kumora/effect-functions": "error"
      }
    },
    {
      // Test helpers, the runtime that runs a script's Effect, and the oxlint
      // plugin, whose rules oxlint calls as plain functions.
      "files": ["scripts/**/*.test.mts", "scripts/lib/testing.mts", "scripts/lib/run.mts", "scripts/oxlint-plugin.mts"],
      "rules": {
        "kumora/effect-functions": "off"
      }
    },
    {
      // Decision: React-free folders skip rules-of-hooks, listed one by one
      // (docs/adr/0014-react-free-code-skips-rules-of-hooks.md)
      "files": ["scripts/**", "packages/client/**", "packages/deploy/**", "packages/relay/**", "packages/server/**", "apps/extension/src/worker/**", "apps/*/alchemy.run.ts", "apps/*/src/server/**", "apps/*/src/worker.ts", "apps/dashboard/billing/**", "apps/dashboard/src/routes/api/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
